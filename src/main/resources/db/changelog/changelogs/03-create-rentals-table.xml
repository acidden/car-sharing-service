<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="03-create-rentals-table" author="acidden">
        <createTable tableName="rentals">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rental_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="return_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="actual_return_date" type="DATE"/>
            <column name="car_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_rentals_cars"
                             referencedTableName="cars"
                             referencedColumnNames="id"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_rentals_users"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
